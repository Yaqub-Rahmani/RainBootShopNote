<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.App.SegmentedToggle" parent="Widget.MaterialComponents.MaterialButtonToggleGroup">
        <item name="android:background">@drawable/bg_btn_primary</item>
    </style>

    <style name="Widget.App.SegmentedToggleButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>

        <item name="cornerRadius">12dp</item>
        <item name="strokeWidth">0dp</item>

        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>

        <item name="backgroundTint">@color/seg_container_bg</item>
        <item name="android:textColor">@color/black</item>
        <item name="rippleColor">@color/seg_btn_ripple</item>
    </style>


    <style name="FilterButtonBase">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:layout_weight">1</item>

        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:drawablePadding">10dp</item>

        <item name="android:textAlignment">viewStart</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>

        <item name="android:textSize">16sp</item>
        <item name="android:shadowRadius">2</item>
    </style>

    <style name="FilterButtonClear" parent="FilterButtonBase">
        <item name="android:backgroundTint">@color/white2</item>
        <item name="android:textColor">@android:color/black</item>
        <item name="android:drawableEnd">@drawable/icon_app_filter_clear</item>
    </style>

    <style name="FilterButtonApply" parent="FilterButtonBase">
        <item name="android:backgroundTint">@android:color/black</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:drawableEnd">@drawable/icon_app_filter_apply</item>
    </style>


    <style name="ActionButtonBase">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:layout_weight">1</item>

        <item name="android:layout_marginStart">10dp</item>
        <item name="android:layout_marginEnd">10dp</item>

        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:drawablePadding">10dp</item>

        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>

        <item name="android:shadowRadius">2</item>
        <item name="android:textSize">16sp</item>
        <item name="android:gravity">center_horizontal</item>
    </style>

    <style name="ActionButtonPrimary" parent="ActionButtonBase">
        <item name="android:backgroundTint">@android:color/black</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:drawableEnd">@drawable/icon_app_filter_apply</item>
    </style>

    <style name="ActionButtonSecondary" parent="ActionButtonBase">
        <item name="android:backgroundTint">@color/white2</item>
        <item name="android:textColor">@android:color/black</item>
        <item name="android:drawableEnd">@drawable/icon_app_close</item>
    </style>

</resources>