<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp"
    android:background="@color/white"
    android:layoutDirection="rtl"
    android:textDirection="rtl"
    tools:context=".add_item">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layoutDirection="rtl"
        android:textDirection="rtl">

        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dyalog_product"
            android:textColor="@color/black"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="15dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:padding="5dp"
            android:background="@color/white3"
            android:drawableStart="@drawable/icon_app_edit"
            android:gravity="center"
            android:textAlignment="center"
            android:layoutDirection="rtl"
            android:textDirection="rtl" />

        <LinearLayout
            android:id="@+id/outItemHide1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end"
            android:layoutDirection="rtl"
            android:textDirection="rtl"
            android:visibility="gone">

            <TextView
                android:id="@+id/txtItemHide1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/delete"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center"
                android:textDirection="rtl"
                android:textAlignment="center" />

            <TextView
                android:id="@+id/txtItemHide2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/delete"
                android:textSize="15sp"
                android:gravity="center"
                android:textDirection="rtl"
                android:textAlignment="center" />
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/outItem1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:hint="@string/productName"
            android:layoutDirection="rtl"
            android:textDirection="rtl"
            app:boxStrokeColor="@android:color/black"
            app:boxBackgroundColor="@android:color/white"
            app:hintEnabled="true"
            app:hintAnimationEnabled="true"
            app:hintTextColor="@color/black">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/txtItem1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:padding="8dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:inputType="text"
                android:maxLines="1"
                android:maxLength="25"
                android:layoutDirection="rtl"
                android:textDirection="rtl"
                android:textAlignment="viewStart"
                android:gravity="start" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/outItem2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:hint="@string/productQuantity"
            android:layoutDirection="rtl"
            android:textDirection="rtl"
            app:boxStrokeColor="@android:color/black"
            app:boxBackgroundColor="@android:color/white"
            app:hintEnabled="true"
            app:hintAnimationEnabled="true"
            app:hintTextColor="@color/black">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/txtItem2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:padding="8dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:inputType="number"
                android:maxLines="1"
                android:maxLength="25"
                android:layoutDirection="rtl"
                android:textDirection="rtl"
                android:textAlignment="viewStart"
                android:gravity="start" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/outItem3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:hint="@string/productPrice"
            android:layoutDirection="rtl"
            android:textDirection="rtl"
            app:boxStrokeColor="@android:color/black"
            app:boxBackgroundColor="@android:color/white"
            app:hintEnabled="true"
            app:hintAnimationEnabled="true"
            app:hintTextColor="@color/black">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/txtItem3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:padding="8dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:inputType="numberDecimal"
                android:maxLines="1"
                android:maxLength="25"
                android:layoutDirection="rtl"
                android:textDirection="rtl"
                android:textAlignment="viewStart"
                android:gravity="start" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/outItem4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/productDescription"
            android:layoutDirection="rtl"
            android:textDirection="rtl"
            app:boxStrokeColor="@android:color/black"
            app:boxBackgroundColor="@android:color/white"
            app:hintEnabled="true"
            app:hintAnimationEnabled="true"
            app:hintTextColor="@color/black">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/txtItem4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:padding="8dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:maxLines="3"
                android:inputType="textMultiLine"
                android:lines="5"
                android:scrollbars="vertical"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:layoutDirection="rtl"
                android:textDirection="rtl"
                android:textAlignment="viewStart"
                android:gravity="start|top" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:weightSum="2"
            android:layoutDirection="rtl"
            android:textDirection="rtl">



            <Button
                android:id="@+id/CancelProductSubmit"
                style="@style/FilterButtonClear"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:text="@string/cancel"
                android:drawableEnd="@drawable/icon_app_close"
                android:layoutDirection="rtl"
                android:textDirection="rtl"
                android:gravity="center_horizontal" />

            <Button
                android:id="@+id/SaveProductSubmit"
                style="@style/FilterButtonApply"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:text="@string/save"
                android:layoutDirection="rtl"
                android:textDirection="rtl"
                android:gravity="center_horizontal" />
        </LinearLayout>

    </LinearLayout>

</RelativeLayout>
