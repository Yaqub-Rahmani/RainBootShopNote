<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingLeft="20dp"
    android:paddingRight="20dp"
    android:paddingTop="16dp"
    android:paddingBottom="16dp"
    android:background="@color/white"
    android:layoutDirection="rtl"
    android:textDirection="rtl">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/db_tools_title_fa"
        android:layout_gravity="center"
        android:textColor="@color/black"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:layout_marginBottom="15dp"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:textAlignment="center"
        android:padding="5dp"
        android:background="@color/white3"
        android:drawableStart="@drawable/ic_lock_pen"
        android:layoutDirection="rtl"
        android:textDirection="rtl" />

    <!-- NEW: Reports / PDF -->
    <Button
        android:id="@+id/btn_db_reports"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/db_tools_all_report_title"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="4dp"
        android:drawableEnd="@drawable/icon_app_pdf"
        android:drawablePadding="10dp"
        android:textSize="16sp"
        android:textColor="@color/black"
        android:backgroundTint="@color/white2"
        android:textAlignment="viewStart"
        android:gravity="center_vertical|start"
        android:layoutDirection="rtl"
        android:textDirection="rtl" />

    <Button
        android:id="@+id/btn_db_export"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/db_tools_export_downloads_fa"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:drawableEnd="@drawable/app_downloads"
        android:drawablePadding="10dp"
        android:textSize="16sp"
        android:textColor="@color/black"
        android:backgroundTint="@color/white2"
        android:textAlignment="viewStart"
        android:gravity="center_vertical|start"
        android:layoutDirection="rtl"
        android:textDirection="rtl" />

    <Button
        android:id="@+id/btn_db_import"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/db_import_title"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:drawableEnd="@drawable/icon_app_db_backup"
        android:drawablePadding="10dp"
        android:textSize="16sp"
        android:textColor="@color/black"
        android:backgroundTint="@color/white2"
        android:textAlignment="viewStart"
        android:gravity="center_vertical|start"
        android:layoutDirection="rtl"
        android:textDirection="rtl" />

    <Button
        android:id="@+id/btn_db_online"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/db_tools_send_online_fa"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"
        android:drawableEnd="@drawable/icon_app_add_backup_database"
        android:drawablePadding="10dp"
        android:textSize="16sp"
        android:textColor="@color/black"
        android:backgroundTint="@color/white2"
        android:textAlignment="viewStart"
        android:gravity="center_vertical|start"
        android:layoutDirection="rtl"
        android:textDirection="rtl" />

</LinearLayout>
