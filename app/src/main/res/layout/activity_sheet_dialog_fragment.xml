<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingLeft="40dp"
    android:paddingRight="40dp"
    android:background="@color/white"
    android:layoutDirection="rtl"
    android:textDirection="rtl">

    <Button
        android:id="@+id/btn_Home"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dyalog_home"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:layout_marginTop="50dp"
        android:layout_marginBottom="4dp"
        android:drawableEnd="@drawable/ic_home"
        android:drawablePadding="10dp"
        android:textSize="16sp"
        android:textColor="@color/black"
        android:backgroundTint="@color/white2"
        android:textAlignment="viewStart"
        android:gravity="center_vertical|start"
        android:layoutDirection="rtl"
        android:textDirection="rtl" />

    <Button
        android:id="@+id/btn_addProductDialog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dyalog_product"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:drawableEnd="@drawable/icon_app_add_product"
        android:drawablePadding="10dp"
        android:textSize="16sp"
        android:textColor="@color/black"
        android:backgroundTint="@color/white2"
        android:textAlignment="viewStart"
        android:gravity="center_vertical|start"
        android:layout_below="@id/btn_Home"
        android:layoutDirection="rtl"
        android:textDirection="rtl" />

    <Button
        android:id="@+id/btn_addUser"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dyalog_user"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:drawableEnd="@drawable/icon_app_add_user"
        android:drawablePadding="10dp"
        android:textSize="16sp"
        android:textColor="@color/black"
        android:backgroundTint="@color/white2"
        android:textAlignment="viewStart"
        android:gravity="center_vertical|start"
        android:layout_below="@id/btn_addProductDialog"
        android:layoutDirection="rtl"
        android:textDirection="rtl" />

    <Button
        android:id="@+id/btn_addChangePassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dyalog_password"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:drawableEnd="@drawable/icon_app_add_password_change"
        android:drawablePadding="10dp"
        android:textSize="16sp"
        android:textColor="@color/black"
        android:backgroundTint="@color/white2"
        android:textAlignment="viewStart"
        android:gravity="center_vertical|start"
        android:layout_below="@id/btn_addUser"
        android:layoutDirection="rtl"
        android:textDirection="rtl" />

    <Button
        android:id="@+id/btn_addBackUp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/db_tools_title_fa"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="60dp"
        android:drawableEnd="@drawable/icon_app_database"
        android:drawablePadding="2dp"
        android:textSize="16sp"
        android:textColor="@color/black"
        android:backgroundTint="@color/white2"
        android:textAlignment="viewStart"
        android:gravity="center_vertical|start"
        android:layout_below="@id/btn_addChangePassword"
        android:layoutDirection="rtl"
        android:textDirection="rtl" />

</RelativeLayout>
