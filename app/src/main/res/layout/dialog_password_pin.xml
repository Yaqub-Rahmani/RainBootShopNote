<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="18dp"
    android:layoutDirection="rtl"
    android:textDirection="rtl">

    <TextView
        android:id="@+id/txtPinTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="تأیید رمز"
        android:layout_gravity="center"
        android:textColor="@color/black"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:layout_marginBottom="15dp"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:textAlignment="center"
        android:padding="5dp"
        android:background="@color/white3"
        android:drawableStart="@drawable/ic_lock_pen"
        android:layoutDirection="rtl"
        android:textDirection="rtl" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="لطفاً رمز ۴ رقمی را وارد کنید."
        android:textSize="13sp"
        android:textColor="#666666"
        android:layoutDirection="rtl"
        android:textDirection="rtl"
        android:textAlignment="viewStart" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilPin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layoutDirection="rtl"
        android:textDirection="rtl"
        app:boxBackgroundMode="outline"
        app:boxCornerRadiusTopStart="6dp"
        app:boxCornerRadiusTopEnd="6dp"
        app:boxCornerRadiusBottomStart="6dp"
        app:boxCornerRadiusBottomEnd="6dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etPin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="رمز ۴ رقمی"
            android:inputType="numberPassword"
            android:maxLength="4"
            android:maxLines="1"
            android:textAlignment="center"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:padding="12dp"
            android:layoutDirection="rtl"
            android:textDirection="ltr" />
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:weightSum="2"
        android:layoutDirection="rtl"
        android:textDirection="rtl">

        <Button
            android:id="@+id/CancelProductSubmit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:backgroundTint="@color/white2"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="لغو"
            android:textSize="14sp"
            android:drawableEnd="@drawable/icon_app_close"
            android:drawablePadding="10dp"
            android:textColor="@android:color/black"
            android:layoutDirection="rtl"
            android:textDirection="rtl"
            android:gravity="center" />

        <Button
            android:id="@+id/SaveProductSubmit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:backgroundTint="@android:color/black"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="تأیید"
            android:textSize="14sp"
            android:drawableEnd="@drawable/icon_app_filter_apply"
            android:drawablePadding="10dp"
            android:textColor="@android:color/white"
            android:layoutDirection="rtl"
            android:textDirection="rtl"
            android:gravity="center" />

    </LinearLayout>

</LinearLayout>
