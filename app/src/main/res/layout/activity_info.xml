<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/app_all_back"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".InfoActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="-10sp"
        android:layout_marginBottom="179dp"
        android:alpha=".70"
        android:background="@color/white"
        android:orientation="vertical"
        android:padding="30sp"
        android:paddingTop="20sp">

        <Button
            android:id="@+id/btn_addBackUp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dyalog_backup"
            android:paddingEnd="20dp"
            android:paddingStart="20dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="60dp"
            android:drawableEnd="@drawable/icon_app_add_backup_database"
            android:drawablePadding="2dp"
            android:textSize="16sp"
            android:textColor="@color/black"
            android:backgroundTint="@color/white2"
            android:textAlignment="textStart"/>


        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="50sp"
            android:gravity="center_horizontal"
            android:padding="5dp"
            android:text="@string/infoNote"
            android:textSize="20sp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="50sp"
            android:gravity="center_horizontal"
            android:padding="5dp"
            android:textColor="@color/red"
            android:text="@string/infoNote2"
            android:textSize="20sp" />

    </LinearLayout>

</RelativeLayout>