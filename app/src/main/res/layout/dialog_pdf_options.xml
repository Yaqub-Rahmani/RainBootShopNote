<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pdf_dialog_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layoutDirection="rtl"
    android:padding="16dp">


    <TextView

        android:id="@+id/txtPdfTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="5dp"
        android:background="@color/white3"
        android:paddingVertical="2dp"
        android:text="@string/pdf_title"
        android:textAlignment="center"
        android:textColor="@color/black"
        android:textSize="25sp" />

    <RadioGroup
        android:id="@+id/rgPdfScope"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">

        <RadioButton
            android:id="@+id/rbPdfFiltered"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/pdf_scope_filtered" />

        <RadioButton
            android:id="@+id/rbPdfAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pdf_scope_all" />
    </RadioGroup>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:weightSum="2">


        <Button
            android:id="@+id/btnPdfCancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:shadowRadius="2"
            android:backgroundTint="@color/white2"
            android:gravity="center_horizontal"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:text="@string/cancel"
            android:textSize="16sp"
            android:textColor="@android:color/black"
            android:drawableEnd="@drawable/icon_app_close"
            android:layout_weight="1"/>

        <Button
            android:id="@+id/btnPdfConfirm"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:shadowRadius="2"
            android:backgroundTint="@color/white3"
            android:gravity="center_horizontal"
            android:text="@string/pdf_create"
            android:textSize="16sp"
            android:textColor="@android:color/black"
            android:drawableLeft="@drawable/icon_app_pdf"
            android:layout_weight="1"/>


    </LinearLayout>



</LinearLayout>
