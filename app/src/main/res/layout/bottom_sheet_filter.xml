<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/filterSheetRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:background="@android:color/transparent">

    <LinearLayout
        android:id="@+id/filterSheetContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp"
        android:layoutDirection="rtl"
        android:background="@android:color/white">

        <!-- Title -->
        <TextView
            android:id="@+id/txtFilterHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/filter_title_fa"
            android:textAlignment="center"
            android:layout_gravity="center"
            android:textColor="@color/black"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:layout_marginBottom="15dp"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="5dp"
            android:background="@color/white3"
            android:drawableStart="@drawable/icon_app_filter"

            />

        <!-- Calendar mode -->
        <TextView
            android:id="@+id/txtCalendarLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="نوع تاریخ"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="@color/black"
            android:textAlignment="viewStart" />

        <LinearLayout
            android:id="@+id/rowCalendarMode"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_action_row_ripple"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:minHeight="48dp">

            <Spinner
                android:id="@+id/spCalendarMode"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </LinearLayout>

        <!-- From date -->
        <LinearLayout
            android:id="@+id/rowFromDate"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_action_row_ripple"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:clickable="true"
            android:focusable="true"
            android:minHeight="48dp">

            <TextView
                android:id="@+id/txtFromLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/filter_from_date_fa"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="@color/black"
                android:maxLines="1"
                android:ellipsize="end"
                android:textAlignment="viewStart" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtFromValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#8A000000"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textAlignment="viewEnd" />

                <TextView
                    android:id="@+id/txtFromValueGreg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="12sp"
                    android:textColor="#6A000000"
                    android:visibility="gone"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textAlignment="viewEnd" />
            </LinearLayout>
        </LinearLayout>

        <!-- To date -->
        <LinearLayout
            android:id="@+id/rowToDate"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_action_row_ripple"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:clickable="true"
            android:focusable="true"
            android:minHeight="48dp">

            <TextView
                android:id="@+id/txtToLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/filter_to_date_fa"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="@color/black"
                android:maxLines="1"
                android:ellipsize="end"
                android:textAlignment="viewStart" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtToValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#8A000000"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textAlignment="viewEnd" />

                <TextView
                    android:id="@+id/txtToValueGreg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="12sp"
                    android:textColor="#6A000000"
                    android:visibility="gone"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textAlignment="viewEnd" />
            </LinearLayout>
        </LinearLayout>

        <!-- Flow type label -->
        <TextView
            android:id="@+id/txtFlowTypeLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/filter_flow_type_fa"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="@color/black"
            android:textAlignment="viewStart" />

        <!-- Flow type spinner container -->
        <LinearLayout
            android:id="@+id/rowFlowType"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_action_row_ripple"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:minHeight="48dp">

            <Spinner
                android:id="@+id/spFlowType"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="14dp"
            android:background="#0F000000" />

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layoutDirection="rtl">

            <Button
                android:id="@+id/btnFilterClear"
                style="@style/FilterButtonClear"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:text="@string/filter_clear" />

            <Button
                android:id="@+id/btnFilterApply"
                style="@style/FilterButtonApply"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:text="@string/filter_apply_fa" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="10dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
